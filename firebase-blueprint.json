{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile document stored in Cloud Firestore",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "service": { "type": "string" },
        "avatarUrl": { "type": "string" },
        "coverImageUrl": { "type": "string" },
        "about": { "type": "string" },
        "category": { "type": "string" },
        "location": { "type": "string" }
      }
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles stored by User ID"
    }
  }
}
